<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Meteos et conditions du jeu de base et des DLC. RimScent en couvre deja six :
       Rain, Fog, RainyThunderstorm et FoggyRain pour le petrichor, ToxicFallout et
       VolcanicWinter. Rien de ce qui suit ne les redouble.

       Aucun MayRequire n'est necessaire : une operation conditionnelle dont le xpath ne
       correspond a rien ne fait rien et ne leve aucune erreur. Les defs d'Anomaly, de
       Biotech et d'Odyssey sont donc visees directement, et le mod fonctionne sans eux.

       Les valeurs restent basses parce que la meteo et les conditions sont lues a
       l'echelle de la carte, hors boucle de cellules : chaque odeur ici touche toute la
       colonie d'un coup. -->

  <!-- Orage sec et tempete d'eclairs : l'ozone avant la pluie qui ne vient pas. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WeatherDef[(defName="DryThunderstorm") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/WeatherDef[(defName="DryThunderstorm") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Ozone</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/WeatherDef[(defName="DryThunderstorm") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/WeatherDef[(defName="DryThunderstorm") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Ozone</thought>
        </li>
        </modExtensions>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/GameConditionDef[(defName="Flashstorm") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/GameConditionDef[(defName="Flashstorm") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Ozone</thought>
        </li>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/GameConditionDef[(defName="Flashstorm") and not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/GameConditionDef[(defName="Flashstorm") and not(modExtensions)]</xpath>
      <value>
        <modExtensions>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScentExtended_Scent_Ozone</thought>
        </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

