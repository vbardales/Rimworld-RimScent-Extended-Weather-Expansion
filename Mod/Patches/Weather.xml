  <!-- Volcanisme d'Odyssey. Le pyromane y est insensible, comme chez RimScent pour
       l'hiver volcanique. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/GameConditionDef[(defName="VolcanicAsh" or defName="VolcanicDebris" or defName="LavaFlow") and modExtensions]/modExtensions</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/GameConditionDef[(defName="VolcanicAsh" or defName="VolcanicDebris" or defName="LavaFlow") and modExtensions]/modExtensions</xpath>
      <value>
        <li Class="RimScentReworked.ModExtension_Scent">
          <thought>RimScent_AshScent</thought>
          <dysosmicTraits>
            <li>Pyromaniac</li>
          </dysosmicTraits>
        </li>
      </value>
    </match>
  </Operation>
