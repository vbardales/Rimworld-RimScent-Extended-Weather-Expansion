<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Vanilla Events Expanded ajoute 5 meteos et 10 conditions, dont aucune ne sentait
       quoi que ce soit. Les conditions et la meteo sont lues a l'echelle de la carte par
       RimScent - hors boucle de cellules - donc chaque odeur ici touche toute la colonie
       d'un coup. D'ou la retenue sur les valeurs.

       Toutes les odeurs de ce fichier sont a stackLimit 1 : une condition et une meteo
       peuvent porter la meme odeur simultanement, et il ne faut pas la compter deux fois.

       On ne parfume que ce qui sent vraiment. Whiteout, long night, psychic stimulation,
       psychic overdrive et psychic hum n'ont volontairement aucune odeur : le froid et
       les phenomenes psychiques n'en ont pas, et leur en inventer une serait du bruit. -->

  <ThoughtDef Name="RimScentExtended_EventScentBase" Abstract="True">
    <durationDays>0.1</durationDays>
    <stackLimit>1</stackLimit>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Drought</defName>
    <stages>
      <li>
        <label>parched air</label>
        <description>Dust, cracked earth and dead grass. There is not a trace of moisture in the air.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Swelter</defName>
    <stages>
      <li>
        <label>sweltering air</label>
        <description>Hot, still, heavy air that smells of sweat and baked dust. Every breath feels used.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_PsychicBloom</defName>
    <stages>
      <li>
        <label>alien blossom</label>
        <description>A sweet, heavy floral scent drifts everywhere. It is pleasant, and nothing on this world smells like it.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================================
       Meteo et conditions du jeu de base et des DLC. Meme regle que ci-dessus :
       stackLimit 1, parce qu'une condition et une meteo peuvent porter la meme odeur
       en meme temps et qu'il ne faut pas la compter deux fois.

       Beaucoup de conditions n'ont volontairement aucune odeur : eclipse, eruption
       solaire, aurore, bourdonnement psychique, obscurite anormale. Le ciel qui change
       ne sent rien, et lui inventer une odeur serait du bruit.
       ============================================================================ -->

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Ozone</defName>
    <stages>
      <li>
        <label>ozone</label>
        <description>Sharp and metallic, the smell of a storm that has not broken yet.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Le froid ne sent rien, et c'est precisement ce qui se remarque : l'air d'hiver est
       vide. Une odeur legerement positive plutot que rien du tout, parce que « ne rien
       sentir » est une experience, pas une absence. -->
  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_ColdAir</defName>
    <stages>
      <li>
        <label>cold clean air</label>
        <description>The cold has taken everything out of the air. There is nothing left to smell, and that is a relief.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_EventScentBase">
    <defName>RimScentExtended_Scent_Spores</defName>
    <stages>
      <li>
        <label>spores</label>
        <description>Something fine and organic hangs in the air. It settles on the tongue.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- ============================================================================
       Odeurs de lieu : le sol et les arbres. Celles-ci sont comptees par case, pas une
       fois pour toutes, donc leur stackLimit est plus haut - c'est ce qui distingue
       trois cases d'eau d'un marecage a perte de vue. Voir ModExtension_TerrainScent
       dans le socle.
       ============================================================================ -->

  <ThoughtDef Name="RimScentExtended_PlaceScentBase" Abstract="True">
    <durationDays>0.1</durationDays>
    <stackLimit>3</stackLimit>
  </ThoughtDef>

  <!-- Les arbres sont des objets, pas du terrain : aucun code n'est necessaire, le patch
       vise le def abstrait qui declare treeCategory. -->
  <ThoughtDef ParentName="RimScentExtended_PlaceScentBase">
    <defName>RimScentExtended_Scent_Forest</defName>
    <stackLimit>4</stackLimit>
    <stages>
      <li>
        <label>forest</label>
        <description>Resin, bark and leaf mould. Green, cool and much older than the colony.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_PlaceScentBase">
    <defName>RimScentExtended_Scent_Water</defName>
    <stages>
      <li>
        <label>fresh water</label>
        <description>Cool water and wet stone. Clean, and it carries a long way.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_PlaceScentBase">
    <defName>RimScentExtended_Scent_Ocean</defName>
    <stages>
      <li>
        <label>sea air</label>
        <description>Salt, iodine and cold open water. It gets into everything and nobody minds.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- La vase ne sent qu'a la chaleur : en dessous du seuil, la case ne compte pas du
       tout. C'est aboveTemperature sur l'extension de terrain, distinct du facteur de
       temperature global du socle - celui-ci attenue une odeur presente, celui-la
       decide qu'elle n'existe pas. -->
  <ThoughtDef ParentName="RimScentExtended_PlaceScentBase">
    <defName>RimScentExtended_Scent_Stagnant</defName>
    <stages>
      <li>
        <label>stagnant water</label>
        <description>Warm mud and standing water. Sulphurous, sweetish, and it clings to the back of the throat.</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef ParentName="RimScentExtended_PlaceScentBase">
    <defName>RimScentExtended_Scent_HotSpring</defName>
    <stackLimit>2</stackLimit>
    <stages>
      <li>
        <label>hot spring</label>
        <description>Warm mineral steam, faintly of sulphur and iron. It smells like somewhere worth stopping.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
